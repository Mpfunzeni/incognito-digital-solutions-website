# Copy to .env.local for local development, and set the same variables in
# your hosting provider's dashboard for production. Never commit real values.

# --- Site -------------------------------------------------------------------
# Canonical site URL (no trailing slash). Used for canonical tags, sitemap,
# Open Graph and structured data.
NEXT_PUBLIC_SITE_URL=https://www.incognitodigitalsolutions.co.za

# Set to "production" ONLY on the live deployment. Any other value (or unset)
# makes robots.txt block crawlers and adds noindex headers/meta, so preview
# and staging sites are never indexed.
NEXT_PUBLIC_SITE_ENV=development

# --- Quote / contact form delivery -------------------------------------------
# "smtp" sends through an SMTP mailbox. Gmail needs no domain: use your Gmail
# address and a Google app password (Google Account > Security >
# 2-Step Verification > App passwords).
# "resend" sends email through Resend (https://resend.com).
# "log" prints enquiries to the server console (development only; ignored in
# production builds). If unset, the form shows an error with direct contact
# details instead of a false success message.
QUOTE_DELIVERY=log
SMTP_USER=
SMTP_PASS=
# Optional: defaults are Gmail (smtp.gmail.com, port 465).
SMTP_HOST=
SMTP_PORT=
# Optional "From" line (defaults to "Incognito Digital Solutions <SMTP_USER>").
SMTP_FROM=
# Optional address customers reply to (defaults to SMTP_USER in smtp mode).
REPLY_TO_EMAIL=
RESEND_API_KEY=
# Where enquiries are delivered (comma-separate multiple addresses; in smtp
# mode defaults to SMTP_USER).
QUOTE_TO_EMAIL=info@incognitodigitalsolutions.co.za
# Sender address. Must be on a domain verified in Resend.
QUOTE_FROM_EMAIL="Incognito Website <website@incognitodigitalsolutions.co.za>"

# --- Analytics & Search Console (optional) -----------------------------------
# GA4 measurement ID (G-XXXXXXXXXX). Analytics loads only after the visitor
# accepts analytics cookies.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console HTML-tag verification token (content value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Contact (optional) ------------------------------------------------------
# Verified WhatsApp business number, digits only with country code, e.g.
# 27848037471. Leave empty to hide all WhatsApp links.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Hosting system: customer accounts, orders and billing -------------------
# PostgreSQL connection string (for example Neon from the Vercel Marketplace,
# or Supabase). Tables are created automatically on first use. Without it,
# local development uses an in-memory database and production shows an
# "online ordering opens soon" message instead of the sign-up and order forms.
DATABASE_URL=
# Optional, development only: folder that keeps the local database between
# restarts (e.g. .data/hosting). Leave empty for an in-memory database.
HOSTING_DEV_DB_DIR=
# Comma-separated emails that can open /account/admin and receive order alerts.
HOSTING_ADMIN_EMAILS=info@incognitodigitalsolutions.co.za
# Optional sender for account emails (defaults to QUOTE_FROM_EMAIL).
HOSTING_FROM_EMAIL=
# Optional base URL for links in emails. Defaults to Vercel's production
# domain (the custom domain once connected), then NEXT_PUBLIC_SITE_URL.
HOSTING_APP_URL=

# PayFast: "sandbox" (test payments, works without an account) or "live".
# Leave empty to hide online payment (customers then pay by EFT).
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
# Must match the passphrase set in PayFast > Settings > Developer Settings.
PAYFAST_PASSPHRASE=

# Banking details shown on unpaid invoices. Leave empty to show "contact us".
NEXT_PUBLIC_EFT_BANK=
NEXT_PUBLIC_EFT_ACCOUNT_NAME=
NEXT_PUBLIC_EFT_ACCOUNT_NUMBER=
NEXT_PUBLIC_EFT_BRANCH_CODE=

# Account set-up: "manual" (you create cPanel accounts and mark them active in
# the admin area) or "whm" (created automatically on payment through your
# cPanel/WHM reseller account).
HOSTING_PROVISIONING=manual
WHM_HOST=
WHM_USERNAME=
# WHM > Development > Manage API Tokens.
WHM_API_TOKEN=
# Nameservers shown to customers who keep their domain elsewhere.
HOSTING_NAMESERVERS=

# Secret Vercel Cron sends to /api/cron/renewals (daily renewal invoices).
CRON_SECRET=
