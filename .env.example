# Copy to .env.local for local development, and set the same variables in
# your hosting provider's dashboard for production. Never commit real values.

# --- Site -------------------------------------------------------------------
# Canonical site URL (no trailing slash). Used for canonical tags, sitemap,
# Open Graph and structured data.
NEXT_PUBLIC_SITE_URL=https://www.incognitodigitalsolutions.co.za

# Set to "production" ONLY on the live deployment. Any other value (or unset)
# makes robots.txt block crawlers and adds noindex headers/meta, so preview
# and staging sites are never indexed.
NEXT_PUBLIC_SITE_ENV=development

# --- Quote / contact form delivery -------------------------------------------
# "resend" sends email through Resend (https://resend.com).
# "log" prints enquiries to the server console (development only; ignored in
# production builds). If unset, the form shows an error with direct contact
# details instead of a false success message.
QUOTE_DELIVERY=log
RESEND_API_KEY=
# Where enquiries are delivered (comma-separate multiple addresses).
QUOTE_TO_EMAIL=info@incognitodigitalsolutions.co.za
# Sender address. Must be on a domain verified in Resend.
QUOTE_FROM_EMAIL="Incognito Website <website@incognitodigitalsolutions.co.za>"

# --- Analytics & Search Console (optional) -----------------------------------
# GA4 measurement ID (G-XXXXXXXXXX). Analytics loads only after the visitor
# accepts analytics cookies.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console HTML-tag verification token (content value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Contact (optional) ------------------------------------------------------
# Verified WhatsApp business number, digits only with country code, e.g.
# 27613168967. Leave empty to hide all WhatsApp links.
NEXT_PUBLIC_WHATSAPP_NUMBER=
